# ===== Intelligence Engine =====
# local  -> 100% offline heuristic/statistical engine (free, no internet)
# openai -> enrich the audit with an OpenAI-compatible endpoint
# gemini -> enrich the audit with Google Gemini
LLM_PROVIDER=local

# OpenAI-compatible provider (optional)
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini

# Google Gemini provider (optional)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# ===== Spider engine =====
# Controlled pause (seconds) between pages to make the live crawl visible
SPIDER_DELAY_SECONDS=0.45
MAX_UPLOAD_MB=25

# ===== CORS =====
FRONTEND_ORIGIN=http://localhost:3000
